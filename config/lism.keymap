#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
                &kp Q    &lt 5 W    &kp E    &kp R    &kp T    &kp Y    &kp U    &lt 3 I    &lt 2 O    &kp P
                &lt 1 A    &kp S    &mt LEFT_SHIFT D    &mt LEFT_ALT F    &mt LEFT_CONTROL G    &mt RIGHT_CONTROL H    &mt RIGHT_ALT J    &mt RIGHT_SHIFT K    &lt 1 L    &kp MINUS
                &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA    &kp PERIOD    &kp SLASH
                &lt 4 TAB    &kp SQT    &kp SEMICOLON    &msc MOVE_Y(100)    &lt 2 SPACE    &lt 3 GRAVE    &kp BACKSPACE    &lt 5 RETURN    &none    &none
                &kp RIGHT_GUI    &kp RS(INT1)    &msc MOVE_X(-100)    &msc MOVE_Y(-100)    &msc MOVE_X(100)    &none    &none    &none
            >;

            sensor-bindings = <&rsr_scrl &rsr_scrl>;
        };

        layer_1 {
            display-name = "Mouse Layer";
            bindings = <
                &trans    &trans    &kp LC(V)    &kp LC(C)    &trans    &kp LC(W)    &kp RC(PAGE_UP)    &kp RC(PAGE_DOWN)    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &mkp MB3    &mkp MB1    &mkp MB2    &trans    &kp RC(T)
                &trans    &trans    &trans    &trans    &trans    &kp RC(RS(T))    &mkp MB4    &mkp MB5    &trans    &trans
                &trans    &trans    &trans    &kp LS(UP)    &kp LC(KP_MINUS)    &kp LC(KP_PLUS)    &kp PAGE_UP    &kp PAGE_DOWN    &trans    &trans
                &trans    &trans    &kp LS(LEFT)    &kp LS(DOWN)    &kp LS(RIGHT)    &trans    &trans    &trans
            >;
        };

        layer_2 {
            display-name = "Number Layer";
            bindings = <
                &kp MINUS    &kp N7    &kp N8    &kp N9    &kp LS(SEMICOLON)    &kp RS(N6)    &kp RS(N7)    &kp RS(N2)    &kp RS(N8)    &kp RS(N9)
                &kp SLASH    &kp N4    &kp N5    &kp N6    &kp LS(SQT)    &kp RS(N1)    &kp LEFT_BRACKET    &kp RS(N3)    &kp RS(N4)    &kp RS(N5)
                &kp N0    &kp N1    &kp N2    &kp N3    &kp PERIOD    &kp RIGHT_BRACKET    &kp NON_US_HASH    &kp RS(RIGHT_BRACKET)    &kp RS(NON_US_HASH)    &kp INT1
                &kp EQUAL    &kp LS(EQUAL)    &kp LS(MINUS)    &kp C_VOLUME_UP    &kp LS(HOME)    &kp LS(END)    &kp DELETE    &kp ESCAPE    &trans    &trans
                &trans    &kp LS(INT3)    &kp LS(HOME)    &kp C_VOLUME_DOWN    &kp LS(END)    &trans    &trans    &trans
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "Arrow Layer";
            bindings = <
                &kp LG(HOME)    &kp LC(PAGE_UP)    &kp LC(TAB)    &kp LC(PAGE_DOWN)    &kp LC(W)    &kp RC(A)    &kp RC(F)    &kp RC(L)    &kp RC(H)    &kp RA(EQUAL)
                &kp HOME    &kp LS(LG(LEFT))    &kp LA(UP)    &kp LS(LG(RIGHT))    &kp END    &kp RS(INS)    &kp RC(INS)    &kp RC(S)    &kp RC(Z)    &kp RC(RS(N4))
                &kp LC(T)    &kp LA(LEFT)    &kp LA(DOWN)    &kp LA(RIGHT)    &kp LC(LS(T))    &kp RC(RS(V))    &kp RC(X)    &kp RC(K)    &kp RC(Y)    &kp RC(RS(SEMICOLON))
                &kp LS(LG(V))    &kp INS    &kp LS(LG(UP))    &kp UP    &kp LC(HOME)    &kp LC(END)    &kp RS(PRINTSCREEN)    &kp RC(I)    &trans    &trans
                &kp LC(LA(PRINTSCREEN))    &kp RC(SEMICOLON)    &kp LEFT    &kp DOWN    &kp RIGHT    &trans    &trans    &trans
            >;
        };

        layer_4 {
            display-name = "Device Layer";
            bindings = <
                &none    &none    &none    &none    &bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
                &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
                &sys_reset    &none    &none    &none    &none    &none    &none    &none    &none    &sys_reset
                &none    &none    &none    &kp LC(LG(D))    &kp LS(SPACE)    &kp LS(CAPSLOCK)    &studio_unlock    &none    &none    &none
                &none    &none    &kp LC(LG(LEFT))    &kp LC(LG(F4))    &kp LC(LG(RIGHT))    &trans    &trans    &trans
            >;
        };

        layer_5 {
            display-name = "Win Layer";
            bindings = <
                &kp LG(L)    &kp LG(D)    &kp LG(HOME)    &kp LG(R)    &kp LG(E)    &kp F1    &kp F2    &kp F3    &kp F4    &kp F5
                &kp LS(LG(S))    &kp LG(Z)    &kp LG(V)    &kp LS(F10)    &kp LC(LG(UP))    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
                &kp LG(X)    &kp LG(I)    &kp LG(PERIOD)    &kp LG(A)    &kp LG(N)    &kp F11    &kp F12    &kp RC(RS(N1))    &kp RC(SEMICOLON)    &kp RC(SQT)
                &kp LA(F4)    &kp LA(SPACE)    &kp LC(LS(ESCAPE))    &kp LG(UP)    &kp LA(RETURN)    &kp LC(LA(TAB))    &kp RC(RS(N))    &kp RC(N)    &trans    &trans
                &kp RC(RS(N5))    &kp RC(RS(N4))    &kp LG(LEFT)    &kp LG(DOWN)    &kp LG(RIGHT)    &trans    &trans    &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
